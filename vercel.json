{
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/views/pages/landing/index.html"
    },
    {
      "source": "/booking-details",
      "destination": "/views/pages/booking-details/index.html"
    },
    {
      "source": "/booking-details/",
      "destination": "/views/pages/booking-details/index.html"
    },
    {
      "source": "/booking-baggage",
      "destination": "/views/pages/booking-baggage/index.html"
    },
    {
      "source": "/booking-baggage/",
      "destination": "/views/pages/booking-baggage/index.html"
    },
    {
      "source": "/booking-contact",
      "destination": "/views/pages/booking-contact/index.html"
    },
    {
      "source": "/booking-contact/",
      "destination": "/views/pages/booking-contact/index.html"
    },
    {
      "source": "/booking-review",
      "destination": "/views/pages/booking-review/index.html"
    },
    {
      "source": "/booking-review/",
      "destination": "/views/pages/booking-review/index.html"
    },
    {
      "source": "/faq",
      "destination": "/views/pages/faq/index.html"
    },
    {
      "source": "/faq/",
      "destination": "/views/pages/faq/index.html"
    },
    {
      "source": "/manage-booking-pin",
      "destination": "/views/pages/manage-booking-pin/index.html"
    },
    {
      "source": "/manage-booking-pin/",
      "destination": "/views/pages/manage-booking-pin/index.html"
    },
    {
      "source": "/_next/:path*",
      "destination": "/public/_next/:path*"
    },
    {
      "source": "/icons/:path*",
      "destination": "/public/icons/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    },
    {
      "source": "/flags/:path*",
      "destination": "/public/flags/:path*"
    },
    {
      "source": "/follow-us/:path*",
      "destination": "/public/follow-us/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "/public/files/:path*"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/public/vendor/:path*"
    }
  ],
  "headers": [
    {
      "source": "/booking-review/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/booking-review",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
